# FrankenPHP (produção). O TLS fica com o proxy da frente (Traefik/Dokploy),
# então aqui é só HTTP, na porta HTTP_PORT (padrão 8019).
{
	frankenphp
	auto_https off
}

:{$HTTP_PORT:8019} {
	root * /var/www/html/public
	encode gzip

	# php_server resolve o front-controller do Laravel (arquivo estático ou index.php)
	php_server
}
