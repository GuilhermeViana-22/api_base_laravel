# Variáveis usadas pelo docker-compose.yml (dev local) — o container MySQL.
# Copie para ".env" antes de rodar `docker compose up`.

# Porta da API no host (dev e produção): http://localhost:8019/api
API_PORT=8019

MYSQL_DATABASE=adsplay_api_base
MYSQL_USER=adsplay_api_base
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root
