APP_NAME="API Laravel Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8019
# Produção: APP_URL=https://univesp.guilhermeviana.com

# CORS — quem pode chamar a API pelo navegador:
# - FRONTEND_URL: o front publicado (separe vários por vírgula);
# - CORS_ALLOW_LOCALHOST=true: libera http://localhost e http://127.0.0.1 em qualquer porta (desenvolvimento).
FRONTEND_URL=https://univesp-tv-front.vercel.app
CORS_ALLOW_LOCALHOST=true

# Validade do token Bearer emitido no login (minutos)
AUTH_TOKEN_TTL_MINUTES=480

# Documentação da API (Swagger UI em /api/documentation, spec em /api/docs.json).
# Aberta em desenvolvimento; em produção as duas dão 404 a menos que isto seja true.
# SWAGGER_ENABLED=true

# Chaves do Passport: ficam em storage/oauth-*.key (fora do git). Em produção
# a pasta storage/ é um volume e o docker/start.sh só gera o par se ele não existir.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=adsplay_api_base
DB_USERNAME=adsplay_api_base
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@guilhermeviana.com"
MAIL_FROM_NAME="Univesp"

# E-mails transacionais (código de verificação do cadastro) via Resend.
# O remetente precisa ser de um domínio verificado no painel do Resend.
RESEND_API_KEY=
# Limites (s) da chamada ao Resend: o e-mail sai dentro da requisição do cadastro
# RESEND_CONNECT_TIMEOUT=5
# RESEND_TIMEOUT=10

# Verificação de e-mail no cadastro
AUTH_VERIFICATION_CODE_TTL_MINUTES=15
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
